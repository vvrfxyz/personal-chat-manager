# PostgreSQL (OrbStack)
DATABASE_URL=postgresql+asyncpg://postgres:wenruifeng@127.0.0.1:5432/personal_chat_manager

# Fernet key for session_encrypted. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
