# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/personal_chat_manager

# Fernet key for session_encrypted. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-me

# Telegram app (https://my.telegram.org/apps)
TELEGRAM_API_ID=replace-me
TELEGRAM_API_HASH=replace-me

# OpenAI (or OpenAI-compatible endpoint — base_url optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173

# Scheduler
SCHEDULER_ENABLED=true
